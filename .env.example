# Put real keys in Vercel environment variables (or a local .env that is never committed).
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional overrides
PRIMARY_MODEL=openai/gpt-oss-120b
SECONDARY_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=google/gemma-4-31b-it:free
# Set to true only while running live evals, then remove
EVALS_ENABLED=
